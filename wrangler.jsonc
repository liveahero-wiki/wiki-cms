{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wiki-cms",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wiki_cms_db",
      "database_id": "b4e6dcc5-f864-431b-9a65-810ea5284932",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "cadf2576726d4960b3537d096bbc307e" }],
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "cache": { "enabled": true },
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "PUBLIC_URL": "https://wiki-cms.rongjie.workers.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFTkkjhm4gH_j2Ca",
    "AI_MODERATION": "off"
  }
}
